<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TableForge.Views.PasteView">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Paste Table" FontSize="20" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12" Foreground="#555" TextWrapping="Wrap">
            <TextBlock.Inlines>
                <Run Text="Paste the copied table text below, then choose Interpret (or press Ctrl+Enter). It will be added to " />
                <Run Text="{Binding CollectionName, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="." />
            </TextBlock.Inlines>
        </TextBlock>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0" Spacing="8">
            <Button Content="Interpret" Padding="18,6" Command="{Binding InterpretCommand}" />
            <Button Content="Cancel" Padding="18,6" Command="{Binding CancelCommand}" />
        </StackPanel>

        <!-- Raw-text cleanup before parsing: fixes clipboard damage the parser might otherwise lose or misclassify. -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Join Lines" Padding="8,3" Margin="0,0,6,4" Click="OnJoinLinesClick"
                    ToolTip.Tip="Ctrl+J — join the selected lines into one line, or the current line into the line above it" />
            <Button Content="Normalize Text" Padding="8,3" Margin="0,0,0,4" Click="OnNormalizeTextClick"
                    ToolTip.Tip="Fix non-breaking spaces, repeated whitespace and fi/fl ligatures, one line at a time" />
            <Button Content="Dehyphenate" Padding="8,3" Margin="6,0,0,4" Click="OnDehyphenateClick"
                    ToolTip.Tip="Remove PDF line-wrap hyphens (&quot;magnifi-&#10;cent&quot; becomes &quot;magnificent&quot;)" />
            <Button x:Name="FindNextDamagedButton" Content="Find Next Damaged Character" Padding="8,3" Margin="6,0,0,4"
                    Click="OnFindNextDamagedClick" IsVisible="{Binding HasDamagedCharacters}" />
            <TextBlock Text="{Binding CleanupMessage}" Foreground="#555" VerticalAlignment="Center" Margin="12,0,0,4" TextWrapping="Wrap" />
        </WrapPanel>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" BorderBrush="#E0B400" BorderThickness="1" CornerRadius="3" Background="#FFF4D6"
                IsVisible="{Binding HasDamagedCharacters}">
            <TextBlock Text="{Binding DamagedCharacterWarning}" Foreground="#7A5200" TextWrapping="Wrap" />
        </Border>

        <TextBox x:Name="PasteSourceBox" Text="{Binding SourceText}"
                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                 FontFamily="DejaVu Sans Mono,Liberation Mono,Consolas,monospace" FontSize="14"
                 ToolTip.Tip="Ctrl+J — join the selected lines into one line, or the current line into the line above it"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</UserControl>
